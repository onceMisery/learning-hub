{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "unicorn", "typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": "error",
    "eqeqeq": "error",
    "no-var": "error",
    "react/react-in-jsx-scope": "off"
  },
  "settings": {
    "react": {
      "runtime": "automatic"
    }
  },
  "ignorePatterns": ["dist", "release", "node_modules", ".tmp-examples"],
  "env": {
    "browser": true,
    "node": true,
    "es2026": true
  }
}
